# MultiRoomChatWebApp - Production/demo environment template
# Sao chép file này thành `.env` trên VPS rồi điền giá trị thật.
# Không commit `.env`. Không điền secret thật vào file mẫu này.

# ---------------------------------------------------------------------------
# Domain và runtime
# ---------------------------------------------------------------------------
APP_HOST=vzchat.id.vn
APP_ORIGIN=https://vzchat.id.vn
MEDIA_HOST=media.vzchat.id.vn
MEDIA_ORIGIN=https://media.vzchat.id.vn
APP_IMAGE=multiroomchat:demo-5a81a37

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
CHAT_APP_INSTANCE_ID=app-1

AllowedHosts=vzchat.id.vn
Cors__AllowedOrigins__0=https://vzchat.id.vn

# ---------------------------------------------------------------------------
# Connection strings - secret, để trống trong template
# Tên service production dự kiến: postgres, mongodb, redis, redis-broker.
# ---------------------------------------------------------------------------
ConnectionStrings__PostgreSQL=
ConnectionStrings__MongoDB=
ConnectionStrings__Redis=
ConnectionStrings__ChatBrokerRedis=

# ---------------------------------------------------------------------------
# BFF authentication, session và CSRF
# ---------------------------------------------------------------------------
Auth__SessionCleanup__ScanIntervalMinutes=60
Auth__SessionCleanup__ExpiredRetentionDays=7
Auth__SessionCleanup__RevokedRetentionDays=7
Auth__SessionCleanup__BatchSize=500

Auth__Bff__Enabled=true
Auth__Bff__RequireCsrf=true
Auth__Bff__CsrfHeaderName=X-CSRF-TOKEN
Auth__Bff__CsrfCookieName=__Host-chatapp_csrf
Auth__Bff__CookieName=__Host-chatapp_session
Auth__Bff__CookiePath=/
Auth__Bff__HttpOnly=true
Auth__Bff__Secure=true
Auth__Bff__SameSite=Lax
Auth__Bff__SessionLifetimeMinutes=1440
Auth__Bff__SlidingExpiration=true
Auth__Bff__RenewalThresholdMinutes=240
Auth__Bff__LastSeenUpdateIntervalMinutes=5

# ---------------------------------------------------------------------------
# Google OAuth - ClientId/ClientSecret là secret
# ---------------------------------------------------------------------------
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Google__CallbackPath=/api/auth/google/callback
Authentication__Google__FrontendCallbackUrl=https://vzchat.id.vn/oauth/callback

# ---------------------------------------------------------------------------
# HTTP security headers
# Bắt đầu ở report-only; chỉ enforce sau khi production-like test không còn
# violation hợp lệ.
# ---------------------------------------------------------------------------
SecurityHeaders__CspEnabled=true
SecurityHeaders__CspReportOnly=true

# ---------------------------------------------------------------------------
# LiveKit Cloud - ApiKey/ApiSecret là secret
# ---------------------------------------------------------------------------
LiveKit__Host=wss://project.livekit.cloud
LiveKit__ApiKey=
LiveKit__ApiSecret=

# ---------------------------------------------------------------------------
# Redis Streams chat broker
# ---------------------------------------------------------------------------
ChatBroker__ConnectionStringName=ChatBrokerRedis
ChatBroker__Database=0
ChatBroker__InstanceIdEnvironmentVariable=CHAT_APP_INSTANCE_ID
ChatBroker__ConsumerNamePrefix=chatapp
ChatBroker__StreamName=chat:{messages}:v1
ChatBroker__PersistenceGroupName=message-persistence-v1
ChatBroker__DeliveryGroupName=message-delivery-v1
ChatBroker__ReadBatchSize=10
ChatBroker__VisibilityTimeoutSeconds=60
ChatBroker__MaxAttempts=5
ChatBroker__RetryBaseDelaySeconds=60
ChatBroker__RetryMaxDelaySeconds=900
ChatBroker__RetryStateTtlHours=168
ChatBroker__ProcessedStreamGraceMinutes=5
ChatBroker__DeadLetterRetentionHours=168
ChatBroker__IdempotencyTtlMinutes=30
ChatBroker__MaintenanceIntervalSeconds=300
ChatBroker__MaintenanceLockSeconds=120

# ---------------------------------------------------------------------------
# MinIO/S3-compatible media storage
# AccessKey/SecretKey là secret.
# ---------------------------------------------------------------------------
MediaStorage__Provider=S3
MediaStorage__Endpoint=https://media.vzchat.id.vn
MediaStorage__PublicEndpoint=https://media.vzchat.id.vn
MediaStorage__AccessKey=
MediaStorage__SecretKey=
MediaStorage__PublicBucket=chatapp-public-media
MediaStorage__PrivateBucket=chatapp-private-media
MediaStorage__ForcePathStyle=true
MediaStorage__SignedUrlMinutes=15
MediaStorage__MaxAvatarBytes=2097152
MediaStorage__MaxImageBytes=10485760
MediaStorage__MaxAudioBytes=26214400
MediaStorage__MaxVideoBytes=104857600
MediaStorage__MaxFileBytes=26214400
MediaStorage__PendingCleanupIntervalMinutes=30
MediaStorage__PendingMediaTtlHours=3
MediaStorage__ReservationTtlHours=24
MediaStorage__PendingCleanupBatchSize=100

# ---------------------------------------------------------------------------
# Voice/direct call
# ---------------------------------------------------------------------------
Voice__DirectCallRingingTimeoutSeconds=60
Voice__MissedCallScanIntervalSeconds=5

# ---------------------------------------------------------------------------
# PostgreSQL container - user/password là secret
# ---------------------------------------------------------------------------
POSTGRES_DB=ChatAppDB
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# MongoDB container - root username/password là secret
# Database ứng dụng hiện được backend cố định là ChatAppDB_Mongo.
# ---------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# MinIO container - root credential là secret
# Trong mô hình một credential demo, hai giá trị này phải khớp với
# MediaStorage__AccessKey và MediaStorage__SecretKey của app.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
